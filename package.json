{
  "name": "apigovscan",
  "private": true,
  "version": "0.0.0-dev",
  "description": "Local-first API governance analyzer — OpenAPI rules engine with elite standards packs",
  "license": "Apache-2.0",
  "author": "fedesauzzadev (https://github.com/fedesauzzadev)",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@9.15.4",
  "scripts": {
    "build": "pnpm -r --filter \"./packages/**\" run build",
    "test": "pnpm -r --filter \"./packages/**\" run test",
    "test:invariants": "vitest run --config vitest.invariants.config.ts",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc -b",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build && pnpm test:invariants",
    "pack:cli": "node scripts/pack-cli.mjs",
    "verify:pack": "node scripts/verify-pack.mjs",
    "gen:license": "node scripts/gen-license.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "^20.17.10",
    "docx": "^9.7.2",
    "eslint": "^9.17.0",
    "pdfkit": "^0.20.2",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.1",
    "vitest": "^2.1.8",
    "yaml": "^2.9.1"
  }
}
