{
  "name": "@apigovscan/cli",
  "version": "0.0.0-dev",
  "description": "ApiGovScan CLI — local-first API governance analyzer",
  "license": "Apache-2.0",
  "author": "fedesauzzadev (https://github.com/fedesauzzadev)",
  "type": "module",
  "bin": {
    "apigovscan": "./bin/apigovscan.js"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/fedesauzzadev/ApiGovScan.git",
    "directory": "packages/cli"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "bin",
    "packs",
    "LICENSE.md"
  ],
  "scripts": {
    "build": "tsc -b && node ./scripts/copy-packs.mjs && esbuild dist/index.js --bundle --platform=node --format=esm --target=node20 --outfile=dist/apigovscan.mjs --banner:js=\"import{createRequire as __apigovscanCreateRequire}from'node:module';const require=__apigovscanCreateRequire(import.meta.url);\"",
    "test": "vitest run",
    "typecheck": "tsc -b --pretty"
  },
  "dependencies": {
    "@apigovscan/core": "workspace:*",
    "@apigovscan/asyncapi": "workspace:*",
    "@apigovscan/webhooks": "workspace:*",
    "@apigovscan/graphql": "workspace:*",
    "@apigovscan/grpc": "workspace:*",
    "@apigovscan/mcp": "workspace:*",
    "@apigovscan/openapi": "workspace:*",
    "@apigovscan/reporters": "workspace:*",
    "mammoth": "^1.12.3",
    "pdf-parse": "1.1.1",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "1.30.1",
    "esbuild": "^0.25.5",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=20"
  }
}
