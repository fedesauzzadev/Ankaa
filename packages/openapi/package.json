{
  "name": "@apigovscan/openapi",
  "version": "0.0.0-dev",
  "description": "OpenAPI parser and normalizer for ApiGovScan (no network)",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b",
    "test": "vitest run",
    "typecheck": "tsc -b --pretty"
  },
  "dependencies": {
    "@apigovscan/core": "workspace:*"
  },
  "devDependencies": {
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=20"
  }
}
